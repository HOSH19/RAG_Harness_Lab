# LLM backend switch:
#   auto   - metal on Apple Silicon, otherwise cuda
#   cuda   - NVIDIA (Docker Compose / native vLLM)
#   metal  - Apple Silicon via vllm-metal (macOS 15+)
#   remote - use VLLM_BASE_URL only (no local serve)
#   none   - RAG/retrieval only (no generation)
LLM_BACKEND=auto

# Optional overrides. Leave MODEL_ID empty to use the backend profile default
# (cuda -> Qwen2.5-7B, metal -> Qwen2.5-3B).
MODEL_ID=
MAX_MODEL_LEN=
GPU_MEMORY_UTILIZATION=
VLLM_HOST=0.0.0.0
VLLM_PORT=8000
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_API_KEY=EMPTY

# Optional: Hugging Face token for gated models
# HF_TOKEN=

# RAG API
RAG_API_HOST=0.0.0.0
RAG_API_PORT=8080
RAG_API_BASE_URL=http://localhost:8080
CHROMA_PATH=.data/chroma
# Vector store files live under .data/store/ (CHROMA_PATH parent + /store)
COLLECTION_NAME=practice_docs
# hashing (default) needs no torch/onnx. Or set a SentenceTransformer id after: pip install -e ".[st]"
EMBEDDING_MODEL=hashing

# Config paths
MODELS_CONFIG=configs/models.yaml
RAG_CONFIG=configs/rag.yaml